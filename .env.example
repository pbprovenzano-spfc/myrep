# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxx.supabase.co
# Anon key: usada no browser (build injeta em window.MYREP_SUPABASE) — NÃO é secret
SUPABASE_ANON_KEY=eyJ...
# Service role: só no servidor (Vercel / .env local) — NUNCA no front
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Access Token pessoal (supabase.com/dashboard/account/tokens) — migrações via scripts/apply-self-service-migration.js
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_STORAGE_BUCKET=assets-clientes
# Bucket privado da caixa de entrada do /admin/ (criado no schema.sql)
SUPABASE_INBOX_BUCKET=inbox

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Para quem chegam alterações, suporte e notificações operacionais
BRIEFING_TO_EMAIL=myrep.sup@gmail.com

# Remetente verificado no Resend (domínio myrep.com.br)
BRIEFING_FROM_EMAIL=My Rep <ola@myrep.com.br>

# E-mail do suporte exibido em /alteracoes/
SUPPORT_EMAIL=myrep.sup@gmail.com

# Asaas — https://www.asaas.com
# Sandbox: https://api-sandbox.asaas.com/v3  |  Produção: https://api.asaas.com/v3
# O painel cria o checkout (PIX ou cartão) com esta chave.
# Mensal: assinatura de R$ 17,90. Anual: R$ 130,80, no cartão até 12x de R$ 10,90.
ASAAS_API_KEY=$aact_xxxxx
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Opcional. Se a chave acima não estiver preenchida, o painel usa estes links prontos.
ASAAS_LINK_MENSAL=
ASAAS_LINK_ANUAL=

# URL pública usada no retorno do checkout. Sem isso, produção usa o host da requisição
# (ou https://myrep.com.br se o host for localhost).
# SITE_URL=https://myrep.com.br

# Webhook: https://myrep.com.br/api/asaas/webhook
# Eventos: CHECKOUT_PAID, PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE, PAYMENT_UPDATED

# Segredo para assinar sessões do /admin/ (qualquer string longa)
PAGAMENTO_TOKEN_SECRET=troque-por-uma-string-longa-e-aleatoria

# Token opcional do webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Senha do painel /admin/ ( /assinantes/ redireciona para cá )
ADMIN_PASSWORD=troque-esta-senha

# Teto de upload do Storage (bytes). Padrão 50 MB, o limite do plano Free do Supabase.
# UPLOAD_MAX_BYTES=52428800

# Deploy local (opcional) — https://vercel.com/account/tokens
# VERCEL_TOKEN=
# Ou Deploy Hook: Vercel → Project myrep → Settings → Git → Deploy Hooks
# VERCEL_DEPLOY_HOOK=
